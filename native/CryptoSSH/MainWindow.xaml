<Window x:Class="CryptoSSH.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CryptoSSH" Width="1400" Height="860" MinWidth="1060" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#1E2132" Foreground="#E8EBF5" FontFamily="Segoe UI" FontSize="13">
  <Grid Background="#1E2132">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
    <Border Background="#151827" BorderBrush="#35394C" BorderThickness="0,0,0,1">
      <DockPanel Margin="14,6">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Width="182" VerticalAlignment="Center">
          <Border Background="#8194EB" CornerRadius="7" Padding="7,4" Margin="0,0,9,0"><TextBlock Text="&gt;_" FontFamily="Consolas" FontWeight="Bold" Foreground="#101728"/></Border>
          <TextBlock Text="CryptoSSH" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="SessionButtons" Orientation="Horizontal"/></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#262A3C" BorderBrush="#35394C" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,18,12,14">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="МОЁ ПРОСТРАНСТВО" FontSize="9" Foreground="#8993AF" Margin="12,0,0,15"/>
            <Button x:Name="ConnectionsNav" Content="▦   Подключения" Style="{StaticResource Nav}" Click="ConnectionsClick"/>
            <Button Content="☆   Избранное" Style="{StaticResource Nav}" Click="FavoritesClick"/>
            <Button x:Name="TokenNav" Content="◇   Токены" Style="{StaticResource Nav}" Click="TokenClick"/>
            <Button x:Name="SnippetsNav" Content="{}{ }   Команды" Style="{StaticResource Nav}" Click="SnippetsClick"/>
            <Border Height="1" Background="#383C50" Margin="9,20"/>
            <TextBlock Text="ГРУППЫ" FontSize="9" Foreground="#8993AF" Margin="12,0,0,10"/>
            <StackPanel x:Name="GroupList"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button x:Name="AppearanceNav" Content="◐   Оформление" Style="{StaticResource Nav}" Click="AppearanceClick"/>
            <Button x:Name="SettingsNav" Content="⚙   Настройки" Style="{StaticResource Nav}" Click="SettingsClick"/>
          </StackPanel><Border/>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Page" Margin="24,22,24,24"/></ScrollViewer>
        <Grid x:Name="TerminalArea" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="#222637" BorderBrush="#35394C" BorderThickness="0,0,0,1"><DockPanel Margin="14,4">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="{}{ }  Команды" Click="TerminalSnippetsClick" Padding="12,5" Margin="0,0,8,0"/><Button Content="◐  Оформление" Click="TerminalAppearanceClick" Padding="12,5"/></StackPanel>
            <TextBlock x:Name="TerminalTitle" VerticalAlignment="Center" Foreground="#A7B2CC" FontSize="11"/>
          </DockPanel></Border>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid x:Name="SessionHost"/>
            <Border x:Name="TerminalDrawer" Grid.Column="1" Width="300" Background="#222637" BorderBrush="#383D52" BorderThickness="1,0,0,0" Visibility="Collapsed">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DrawerContent" Margin="18"/></ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#171B29" BorderBrush="#35394C" BorderThickness="0,1,0,0"><DockPanel Margin="14,0"><ProgressBar x:Name="TokenProgress" DockPanel.Dock="Right" Width="110" Height="4" Margin="12,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="#8194EB"/><TextBlock x:Name="Status" DockPanel.Dock="Right" Text="Готов к работе" Foreground="#929DB5" FontSize="10" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="CryptoSSH 1.0.0   /   " Foreground="#747F9B" FontSize="10"/><TextBlock x:Name="Breadcrumb" FontSize="10" Foreground="#9FAAC2"/></StackPanel></DockPanel></Border>
  </Grid>
</Window>
